# OpenAlex Identification (Polite Pool - OpenAlex requests an email in mailto format)
OPENALEX_EMAIL=your_email@domain.com
OPENALEX_API_KEY=your_openalex_api_key_here

# Neon PostgreSQL Database URL
# Example: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Review & Protection Settings
ADMIN_PASSWORD=your_secure_admin_password_here
MAX_DAILY_AI_DRAFTS=20
